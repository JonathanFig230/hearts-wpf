<Window x:Class="HeartsWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearts" Height="720" Width="1100"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <SolidColorBrush x:Key="Felt" Color="#0b5d3b"/>
        <SolidColorBrush x:Key="FeltDark" Color="#084a2f"/>
        <SolidColorBrush x:Key="Gold" Color="#d4af37"/>

        <Style x:Key="BigBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="7,0"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource BigBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#999"/>
        </Style>
        <Style x:Key="TopBtn" TargetType="Button">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ============ INTRO SCREEN ============ -->
        <Grid x:Name="IntroScreen">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#0b5d3b" Offset="0"/>
                    <GradientStop Color="#084a2f" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="♥ HEARTS" FontSize="52" FontWeight="Bold" Foreground="{StaticResource Gold}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="The classic trick-taking card game" Foreground="#cde" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Play" Style="{StaticResource BigBtn}" Click="BtnPlay_Click"/>
                    <Button Content="How to Play" Style="{StaticResource SecondaryBtn}" Click="BtnHowToPlay_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============ INSTRUCTIONS SCREEN ============ -->
        <Grid x:Name="InstructionsScreen" Visibility="Collapsed">
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#0b5d3b" Offset="0"/>
                    <GradientStop Color="#084a2f" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <TextBlock Text="How to Play" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Gold}"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <Border Background="#33000000" BorderBrush="#2a6" BorderThickness="1" CornerRadius="8"
                        Padding="24" Margin="0,0,0,24" MaxHeight="480">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Goal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#eee" Margin="0,0,0,14" LineHeight="22">
                                Hearts is a trick-taking game for 4 players. Points are bad — you're trying to score as few points as possible. The game ends when a player reaches 100 points; the lowest score wins.
                            </TextBlock>
                            <TextBlock Text="Scoring" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#eee" Margin="0,0,0,14" LineHeight="22">
                                Each heart card is worth 1 point. The Queen of Spades (♠Q) is worth 13 points. All other cards are worth 0.
                            </TextBlock>
                            <TextBlock Text="Passing" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#eee" Margin="0,0,0,14" LineHeight="22">
                                Before most hands, you choose 3 cards from your hand to pass to another player (left, right, or across, rotating each hand). Every 4th hand, no cards are passed.
                            </TextBlock>
                            <TextBlock Text="Playing a Trick" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#eee" Margin="0,0,0,10" LineHeight="22">
                                Whoever holds the 2 of Clubs leads the first trick. Players must follow the suit that was led if they can. If you can't follow suit, you may play any card. The highest card of the led suit wins the trick, and the winner leads the next one.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="#eee" Margin="0,0,0,14" LineHeight="22">
                                Hearts can't be led until a heart has been "broken" (played on a previous trick because a player couldn't follow suit) — unless a player has nothing but hearts left. On the very first trick of a hand, no point cards (hearts or ♠Q) may be played at all.
                            </TextBlock>
                            <TextBlock Text="Shooting the Moon" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#eee" LineHeight="22">
                                If one player manages to collect all 26 point cards (every heart plus ♠Q) in a single hand, they score 0 instead, and everyone else scores 26.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Back" Style="{StaticResource SecondaryBtn}" Click="BtnInstructionsBack_Click"/>
                    <Button Content="Play" Style="{StaticResource BigBtn}" Click="BtnPlay_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============ GAME SCREEN ============ -->
        <Grid x:Name="GameScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Background="#111" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="♥ HEARTS" Foreground="{StaticResource Gold}" FontWeight="Bold"
                           FontSize="18" VerticalAlignment="Center" Margin="16,0"/>
                <StackPanel x:Name="TopScoresPanel" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="Exit" Style="{StaticResource TopBtn}" Click="BtnExit_Click"/>
                    <Button Content="Scoreboard" Style="{StaticResource TopBtn}" Click="BtnScoreboard_Click"/>
                </StackPanel>
            </Grid>

            <!-- Table -->
            <Grid Grid.Row="1">
                <Grid.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#0b5d3b" Offset="0"/>
                        <GradientStop Color="#084a2f" Offset="1"/>
                    </RadialGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- North -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Border Background="#59000000" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center"
                            x:Name="NorthLabelBorder">
                        <TextBlock x:Name="NorthLabel" Text="North" Foreground="White" FontSize="13"/>
                    </Border>
                    <StackPanel x:Name="NorthBacks" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Middle: West / Center / East -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Background="#59000000" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center"
                                x:Name="WestLabelBorder">
                            <TextBlock x:Name="WestLabel" Text="West" Foreground="White" FontSize="13"/>
                        </Border>
                        <StackPanel x:Name="WestBacks" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fixed 280x240 canvas with cards placed at absolute positions (64x90 each),
                         so a card can never be squeezed/clipped by a row that's shorter than it. -->
                    <Canvas Grid.Column="1" Width="280" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl x:Name="TrickNorth" Canvas.Left="108" Canvas.Top="0"/>
                        <ContentControl x:Name="TrickWest" Canvas.Left="0" Canvas.Top="75"/>
                        <ContentControl x:Name="TrickEast" Canvas.Left="216" Canvas.Top="75"/>
                        <ContentControl x:Name="TrickSouth" Canvas.Left="108" Canvas.Top="150"/>
                    </Canvas>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="#59000000" CornerRadius="12" Padding="10,3" HorizontalAlignment="Center"
                                x:Name="EastLabelBorder">
                            <TextBlock x:Name="EastLabel" Text="East" Foreground="White" FontSize="13"/>
                        </Border>
                        <StackPanel x:Name="EastBacks" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- South (human hand) -->
                <StackPanel x:Name="SouthHandPanel" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,0,0,10"/>
            </Grid>

            <!-- Status bar -->
            <Grid Grid.Row="2" Background="#111" MinHeight="52">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="Welcome to Hearts!" Foreground="#ffe" FontSize="14"
                               VerticalAlignment="Center"/>
                    <Button x:Name="StatusActionBtn" Style="{StaticResource BigBtn}" Margin="12,0,0,0"
                            Visibility="Collapsed" Click="StatusActionBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ MODALS ============ -->
        <Grid x:Name="RoundModal" Visibility="Collapsed" Background="#B2000000">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="10"
                    Padding="28,24" MinWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="RoundModalTitle" Text="Hand Results" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                    <Grid x:Name="RoundModalTable"/>
                    <Button Content="Continue" Style="{StaticResource BigBtn}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="RoundModalContinue_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="GameOverModal" Visibility="Collapsed" Background="#B2000000">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="10"
                    Padding="28,24" MinWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Game Over" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                    <TextBlock x:Name="GameOverMsg" Foreground="#eee" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid x:Name="GameOverTable"/>
                    <Button Content="Play Again" Style="{StaticResource BigBtn}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="GameOverRestart_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ExitConfirmModal" Visibility="Collapsed" Background="#B2000000">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="10"
                    Padding="28,24" MinWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Exit Game?" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                    <TextBlock Foreground="#eee" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Are you sure you want to exit? Your current game progress will be lost."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Yes, Exit" Style="{StaticResource BigBtn}" Click="ExitConfirmYes_Click"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryBtn}" Click="ExitConfirmCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ScoreboardModal" Visibility="Collapsed" Background="#B2000000">
            <Border Background="#1e1e1e" BorderBrush="#444" BorderThickness="1" CornerRadius="10"
                    Padding="28,24" MinWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Scoreboard" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,12"/>
                    <Grid x:Name="ScoreboardTable"/>
                    <Button Content="Close" Style="{StaticResource BigBtn}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="ScoreboardClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
